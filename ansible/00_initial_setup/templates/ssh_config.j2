# Thinkube Baremetal SSH Configuration
# Generated by Ansible on {{ ansible_date_time.date }}
# WARNING: DO NOT EDIT THE SECTION BETWEEN BEGIN-THINKUBE-BAREMETAL and END-THINKUBE-BAREMETAL markers
#
# Addresses are resolved when the connection is made, not when this file is
# written. Node addresses come from DHCP and move; a HostName written here
# would be correct on the day it was generated and wrong after the next lease
# change, which is how the cluster ends up unable to reach a node that is
# running and healthy.
#
# Under Tailscale, node-to-node traffic uses the LAN address, so each host is
# reached through thinkube-node-ip, which asks the cluster for the node's
# current InternalIP and falls back to the last known address if the cluster
# cannot answer. Under ZeroTier the overlay address is static and is used
# directly. This mirrors what 20_join_workers.yaml writes for workers.

# BEGIN-THINKUBE-BAREMETAL
{%- set host_ip_key = 'overlay_ip' if overlay_provider | default('tailscale') == 'zerotier' else 'lan_ip' %}
{% for host in groups['baremetal'] %}
Host {{ host }}
{%- if overlay_provider | default('tailscale') == 'zerotier' %}
  HostName {{ hostvars[host][host_ip_key] | default(hostvars[host]['ansible_host']) }}
{%- else %}
  ProxyCommand {{ ansible_user_dir }}/.local/bin/thinkube-node-ip --connect {{ host }} 22 {{ hostvars[host][host_ip_key] | default(hostvars[host]['ansible_host']) }}
{%- endif %}
  User {{ ansible_user_id }}
  IdentityFile {{ ansible_user_dir }}/.ssh/{{ ssh_key_name }}
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

{% endfor %}
# END-THINKUBE-BAREMETAL
