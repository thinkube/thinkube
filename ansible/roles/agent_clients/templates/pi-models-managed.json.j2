{#
  The "thinkube" provider of ~/.pi/agent/models.json. tasks/clients.yaml
  replaces this provider and keeps every other one. The gateway serves Qwen
  models on vLLM, which take thinking on or off as
  chat_template_kwargs.enable_thinking ("qwen-chat-template").
#}
{
  "baseUrl": {{ agent_gateway_url | to_json }},
  "api": "openai-completions",
  "apiKey": "${THINKUBE_API_TOKEN}",
  "compat": { "thinkingFormat": "qwen-chat-template" },
  "models": [
{% for alias, m in thinkube_model_aliases.items() %}
    {
      "id": {{ alias | to_json }},
      "name": {{ m.name | to_json }},
      "reasoning": true,
      "input": ["text"],
      "contextWindow": {{ m.context_window }},
      "maxTokens": {{ m.max_output }}
    }{% if not loop.last %},{% endif %}

{% endfor %}
  ]
}
