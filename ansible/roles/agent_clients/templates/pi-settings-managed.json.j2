{#
  The keys of ~/.pi/agent/settings.json Thinkube manages; the user's other
  settings are kept. enableInstallTelemetry false stops the install report to
  pi.dev (the image also sets PI_TELEMETRY=0 and PI_OFFLINE=1).
#}
{
  "defaultProvider": "thinkube",
  "enableInstallTelemetry": false,
  "enableAnalytics": false
}
