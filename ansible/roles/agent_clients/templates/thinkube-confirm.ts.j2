//
// Generated by Thinkube (ansible/roles/agent_clients) from the MCP server
// list; a configuration run replaces this file.
//
// Asks before a Thinkube MCP tool that is not read-only runs. Pi has no
// approval step of its own: every MCP call, including one made from a
// codemode script, passes through the tool_call event, and a handler that
// returns { block: true } stops it. Without a UI (pi -p, --mode json) there
// is nobody to ask, so the call is blocked.

import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

// Pi names an MCP tool mcp__<server>__<tool>, every character other than a
// letter, digit or _ replaced by _.
const servers: { prefix: string; readOnly: RegExp[] }[] = [
{% for server in agent_mcp_servers %}
	{
		prefix: {{ ('mcp__' ~ (server.name | regex_replace('[^A-Za-z0-9_]', '_')) ~ '__') | to_json }},
		readOnly: [{% for p in server.read_only_tools %}{{ ('^' ~ (p | regex_escape | replace('\\*', '.*')) ~ '$') | to_json }}{% if not loop.last %}, {% endif %}{% endfor %}].map((p) => new RegExp(p)),
	},
{% endfor %}
];

export default function (pi: ExtensionAPI) {
	pi.on("tool_call", async (event, ctx) => {
		const server = servers.find((s) => event.toolName.startsWith(s.prefix));
		if (!server) return undefined;
		const tool = event.toolName.slice(server.prefix.length);
		if (server.readOnly.some((p) => p.test(tool))) return undefined;

		if (!ctx.hasUI) {
			return { block: true, reason: `${event.toolName} changes the platform and needs confirmation; this session has no UI to ask` };
		}
		const args = JSON.stringify(event.input ?? {}, null, 2);
		if (!(await ctx.ui.confirm(`Run ${tool}?`, `${event.toolName}\n\n${args}`))) {
			return { block: true, reason: `${event.toolName} was not approved` };
		}
		return undefined;
	});
}
