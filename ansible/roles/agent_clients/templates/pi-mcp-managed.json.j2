{#
  The Thinkube entries of mcpServers in ~/.pi/agent/mcp.json; the user's other
  servers are kept. Tools are "deferred": the model finds them with
  tool_search and then calls them directly.
#}
{
{% for s in agent_mcp_servers %}
  {{ s.name | to_json }}: {% if s.transport == 'http' %}{
    "url": {{ s.url | to_json }},
{% if s.bearer_token_env is defined %}
    "headers": { "Authorization": {{ ('Bearer ${' ~ s.bearer_token_env ~ '}') | to_json }} },
{% endif %}
    "description": {{ s.description | to_json }},
    "exposure": "deferred"
  }{% else %}{
    "command": {{ s.command | to_json }},
    "args": {{ s.args | to_json }},
    "description": {{ s.description | to_json }},
    "exposure": "deferred"
  }{% endif %}{% if not loop.last %},{% endif %}

{% endfor %}
}
