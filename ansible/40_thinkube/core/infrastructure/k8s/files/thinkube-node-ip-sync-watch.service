# Managed by Thinkube — do not edit.
# The timer-driven half of the node-ip sync, running the same script as
# thinkube-node-ip-sync.service.
#
# It exists as a separate unit for one reason: the boot unit is ordered
# Before=kubelet.service so it can correct the address before kubelet ever
# registers. That ordering is meaningful only at boot, and it is actively
# harmful afterwards — a unit ordered before kubelet cannot restart kubelet
# without systemd holding the restart until that unit finishes. This unit
# carries no ordering relationship to kubelet, so it is free to restart it.
[Unit]
Description=Thinkube: node-ip sync (periodic check)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/thinkube-node-ip-sync
