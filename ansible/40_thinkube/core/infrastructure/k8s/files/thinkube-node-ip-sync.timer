# Managed by Thinkube — do not edit.
# The boot-time run cannot see an address that moves under a running node:
# a DHCP lease renewing onto a different address leaves kubelet holding one
# that exists on no interface, which stops node status updates and breaks
# both the Cilium node-to-node datapath and apiserver→kubelet. This timer
# closes that window.
[Unit]
Description=Thinkube: periodic node-ip sync

[Timer]
# Deliberately a calendar trigger rather than OnUnitInactiveSec: the latter
# schedules relative to the service's last deactivation, which never arrives
# on a node whose boot run is still held active, leaving the timer armed but
# never firing. A calendar trigger needs no such reference point. The script
# is a no-op unless the address actually changed.
OnCalendar=*:0/1
RandomizedDelaySec=15s
AccuracySec=10s
# The watch unit, never the boot unit: the boot unit's ordering before
# kubelet would stall any restart it tried to perform.
Unit=thinkube-node-ip-sync-watch.service

[Install]
WantedBy=timers.target
