# Managed by Thinkube — do not edit.
# A worker whose link dies stays powered but unreachable; nothing in the
# cluster can act on it from outside. This timer runs the local link check
# once a minute so the node can reset its own interface, and as a last
# resort reboot itself, without a person walking over to it.
[Unit]
Description=Thinkube: periodic worker link check

[Timer]
# Calendar trigger, not OnUnitInactiveSec: the script counts consecutive
# failed checks, so the cadence must be fixed regardless of how long a
# given run (interface bounce, PCI re-probe) takes.
OnCalendar=*:0/1
RandomizedDelaySec=10s
AccuracySec=10s
Unit=thinkube-link-watchdog.service

[Install]
WantedBy=timers.target
