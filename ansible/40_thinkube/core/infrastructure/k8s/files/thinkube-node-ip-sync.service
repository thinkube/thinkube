# Managed by Thinkube — do not edit.
# Self-healing for the network-dependent node values; see
# /usr/local/bin/thinkube-node-ip-sync. Run at boot by this unit and
# thereafter by thinkube-node-ip-sync.timer.
[Unit]
Description=Thinkube: sync kubelet node-ip to the current network
# Run after the network settles but always before kubelet registers.
Wants=network-online.target
After=network-online.target
Before=kubelet.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/thinkube-node-ip-sync
# Deliberately not RemainAfterExit: the unit must fall back to inactive so
# the timer can trigger it again. Ordering before kubelet is unaffected.

[Install]
WantedBy=multi-user.target
