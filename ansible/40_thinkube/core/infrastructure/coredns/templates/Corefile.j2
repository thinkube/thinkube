.:53 {
    errors
    health {
        lameduck 5s
    }
    ready
    # Logs failed answers only (SERVFAIL, REFUSED, NOTIMP); every-query
    # logging rotates the container log within minutes.
    log . {
        class error
    }
    
    # Handle Kubernetes services ONLY
    kubernetes cluster.local in-addr.arpa ip6.arpa {
        pods insecure
        fallthrough in-addr.arpa ip6.arpa
        ttl 30
    }
    
    prometheus :9153
    
    # Forward everything else to BIND9 DNS server
    # BIND9 handles domain resolution and external queries
    forward . {{ coredns_external_ip }} {
        max_concurrent 1000
    }
    
    cache 30
    loop
    reload
    loadbalance
}