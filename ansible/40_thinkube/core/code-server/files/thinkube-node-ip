#!/usr/bin/env python3
# Managed by Thinkube — do not edit.
"""Resolve a cluster node's current address from the cluster itself.

Node addresses on a Thinkube cluster are dynamic: every node takes its
address from DHCP and the node-ip sync keeps the node's Kubernetes
InternalIP current when a lease moves. Anything that stores an address
(inventory, SSH config) therefore goes stale. This tool makes the cluster
the source of truth for those places:

    thinkube-node-ip NODE [FALLBACK]
        Print NODE's InternalIP. If the cluster cannot answer, print
        FALLBACK (the last known address) instead. Never fails, so an
        inventory `lookup('pipe', ...)` on it never aborts a run.

    thinkube-node-ip --connect NODE PORT [FALLBACK]
        Relay stdin/stdout to NODE:PORT (an ssh ProxyCommand), resolving
        NODE the same way.

When a live lookup returns an address different from FALLBACK, the
inventory file holding that FALLBACK is rewritten in place so the
bootstrap value — the one used when the cluster is unreachable — never
stays stale for longer than one successful run.

Only the standard library (plus PyYAML, which Ansible already requires)
is used, so the same file works wherever a playbook is run: code-server,
thinkube-control, or a node.
"""
import base64
import json
import os
import selectors
import socket
import ssl
import sys
import tempfile
import urllib.request

API_TIMEOUT_SECONDS = 3
INVENTORY_ENV = "THINKUBE_INVENTORY"
DEFAULT_INVENTORY = os.path.expanduser("~/.ansible/inventory/inventory.yaml")
SERVICE_ACCOUNT_DIR = "/var/run/secrets/kubernetes.io/serviceaccount"


def _materialise(data_b64, scratch):
    """Write base64 PEM data to a temp file, record it in scratch, return its path."""
    f = tempfile.NamedTemporaryFile(delete=False, suffix=".pem")
    f.write(base64.b64decode(data_b64))
    f.close()
    scratch.append(f.name)
    return f.name


def _kubeconfig_client():
    """(server, ssl_context, headers) from $KUBECONFIG or ~/.kube/config, or None."""
    path = os.environ.get("KUBECONFIG") or os.path.expanduser("~/.kube/config")
    if not os.path.exists(path):
        return None
    try:
        import yaml  # noqa: WPS433 — Ansible's own dependency
        with open(path) as fh:
            cfg = yaml.safe_load(fh) or {}
    except Exception:
        return None
    contexts = {c["name"]: c["context"] for c in cfg.get("contexts", [])}
    ctx = contexts.get(cfg.get("current-context")) or next(iter(contexts.values()), None)
    if not ctx:
        return None
    clusters = {c["name"]: c["cluster"] for c in cfg.get("clusters", [])}
    users = {u["name"]: u["user"] for u in cfg.get("users", [])}
    cluster = clusters.get(ctx.get("cluster"))
    user = users.get(ctx.get("user"), {})
    if not cluster or "server" not in cluster:
        return None

    # The TLS context reads PEM files once at load time; the temp copies
    # of inline kubeconfig data are removed right after, before any
    # long-lived relay could be killed from outside and leave them behind.
    scratch = []
    try:
        context = ssl.create_default_context()
        if cluster.get("certificate-authority-data"):
            context.load_verify_locations(cafile=_materialise(cluster["certificate-authority-data"], scratch))
        elif cluster.get("certificate-authority"):
            context.load_verify_locations(cafile=cluster["certificate-authority"])
        elif cluster.get("insecure-skip-tls-verify"):
            context.check_hostname = False
            context.verify_mode = ssl.CERT_NONE

        headers = {}
        if user.get("client-certificate-data") and user.get("client-key-data"):
            context.load_cert_chain(
                _materialise(user["client-certificate-data"], scratch),
                _materialise(user["client-key-data"], scratch),
            )
        elif user.get("client-certificate") and user.get("client-key"):
            context.load_cert_chain(user["client-certificate"], user["client-key"])
        elif user.get("token"):
            headers["Authorization"] = "Bearer " + user["token"]
        else:
            return None
        return cluster["server"], context, headers
    finally:
        for path in scratch:
            try:
                os.remove(path)
            except OSError:
                pass


def _in_cluster_client():
    """(server, ssl_context, headers) from a mounted service account, or None."""
    token_path = os.path.join(SERVICE_ACCOUNT_DIR, "token")
    ca_path = os.path.join(SERVICE_ACCOUNT_DIR, "ca.crt")
    host = os.environ.get("KUBERNETES_SERVICE_HOST")
    port = os.environ.get("KUBERNETES_SERVICE_PORT", "443")
    if not (host and os.path.exists(token_path) and os.path.exists(ca_path)):
        return None
    with open(token_path) as fh:
        token = fh.read().strip()
    context = ssl.create_default_context(cafile=ca_path)
    return "https://%s:%s" % (host, port), context, {"Authorization": "Bearer " + token}


def live_internal_ip(node):
    """The node's InternalIP as the cluster reports it, or None."""
    for factory in (_kubeconfig_client, _in_cluster_client):
        try:
            client = factory()
        except Exception:
            client = None
        if not client:
            continue
        server, context, headers = client
        req = urllib.request.Request(server.rstrip("/") + "/api/v1/nodes/" + node, headers=headers)
        try:
            with urllib.request.urlopen(req, context=context, timeout=API_TIMEOUT_SECONDS) as resp:
                body = json.load(resp)
        except Exception:
            continue
        for addr in body.get("status", {}).get("addresses", []):
            if addr.get("type") == "InternalIP" and addr.get("address"):
                return addr["address"]
    return None


def refresh_fallback(node, old, new):
    """Rewrite `thinkube-node-ip NODE OLD` to NEW in the inventory, atomically."""
    path = os.environ.get(INVENTORY_ENV) or DEFAULT_INVENTORY
    if not os.path.exists(path):
        return
    needle = "thinkube-node-ip %s %s" % (node, old)
    try:
        with open(path) as fh:
            text = fh.read()
        if needle not in text:
            return
        text = text.replace(needle, "thinkube-node-ip %s %s" % (node, new))
        tmp = tempfile.NamedTemporaryFile("w", delete=False, dir=os.path.dirname(path), prefix=".inventory.")
        tmp.write(text)
        tmp.close()
        os.chmod(tmp.name, os.stat(path).st_mode & 0o7777)
        os.replace(tmp.name, path)
    except Exception:
        pass


def resolve(node, fallback):
    ip = live_internal_ip(node)
    if ip:
        if fallback and ip != fallback:
            refresh_fallback(node, fallback, ip)
        return ip
    return fallback or ""


def relay(host, port):
    """Pump stdin→socket and socket→stdout until either side closes."""
    sock = socket.create_connection((host, port), timeout=10)
    sock.settimeout(None)
    stdin = sys.stdin.buffer
    stdout = sys.stdout.buffer
    sel = selectors.DefaultSelector()
    sel.register(stdin, selectors.EVENT_READ, "in")
    sel.register(sock, selectors.EVENT_READ, "sock")
    open_sides = 2
    while open_sides:
        for key, _ in sel.select():
            if key.data == "in":
                chunk = os.read(stdin.fileno(), 65536)
                if not chunk:
                    sel.unregister(stdin)
                    sock.shutdown(socket.SHUT_WR)
                    open_sides -= 1
                    continue
                sock.sendall(chunk)
            else:
                chunk = sock.recv(65536)
                if not chunk:
                    sel.unregister(sock)
                    open_sides -= 1
                    continue
                stdout.write(chunk)
                stdout.flush()
    sock.close()


def main(argv):
    if len(argv) >= 3 and argv[0] == "--connect":
        node, port = argv[1], int(argv[2])
        fallback = argv[3] if len(argv) > 3 else ""
        target = resolve(node, fallback)
        if not target:
            sys.stderr.write("thinkube-node-ip: no address for %s\n" % node)
            return 1
        relay(target, port)
        return 0
    if len(argv) in (1, 2):
        sys.stdout.write(resolve(argv[0], argv[1] if len(argv) == 2 else ""))
        return 0
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
