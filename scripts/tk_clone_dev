#!/bin/bash

# Copyright Alejandro Martínez Corriá and the Thinkube contributors
# SPDX-License-Identifier: Apache-2.0

# Clone the Thinkube development repositories into ~/thinkube-platform.
# Run from the code-server terminal.
#
# Usage:
#   tk_clone_dev
#
# The list is the entries of thinkube-metadata's repositories.json with
# clone_for_development: true. Each goes to ~/thinkube-platform/<category>/<name>.
# A repository that is already there is left as it is, so local work is never
# touched. THINKUBE_BRANCH selects the branch to clone (default: main).
#
# It also installs the developer add-on to the agents' instructions:
# ~/.claude/THINKUBE-DEVELOPER.md, imported by ~/.claude/CLAUDE.md, from
# ansible/roles/agent_clients/files/developer/ in the thinkube checkout. The
# platform's base instructions stay as they are; a user's cluster, which never
# runs this script, does not get the add-on. `tk_clone_dev --remove-addon`
# removes it.
#
# The add-on also widens Claude Code's permissions for developing the
# platform (claude-permissions.json next to the add-on): every tool is
# allowed, and destructive git and GitHub actions still ask. The rules are
# merged into ~/.claude/settings.json and taken out again by --remove-addon.

set -e

PLATFORM_DIR="/home/thinkube/thinkube-platform"
ADDON_DIR="$PLATFORM_DIR/core/thinkube/ansible/roles/agent_clients/files/developer"
ADDON_NAME="THINKUBE-DEVELOPER.md"
ADDON_SRC="$ADDON_DIR/$ADDON_NAME"
PERMISSIONS_SRC="$ADDON_DIR/claude-permissions.json"
CLAUDE_DIR="/home/thinkube/.claude"

# Adds (add) or removes (remove) the developer permission rules in
# ~/.claude/settings.json; every other setting is kept.
developer_permissions() {
  python3 - "$1" "$PERMISSIONS_SRC" "$CLAUDE_DIR/settings.json" <<'EOF'
import json, os, sys
action, rules_path, settings_path = sys.argv[1:4]
rules = json.load(open(rules_path))
settings = json.load(open(settings_path)) if os.path.exists(settings_path) else {}
perms = settings.setdefault("permissions", {})
for kind in ("allow", "ask"):
    current = perms.setdefault(kind, [])
    if action == "add":
        current.extend(r for r in rules[kind] if r not in current)
    else:
        perms[kind] = [r for r in current if r not in rules[kind]]
with open(settings_path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
EOF
}

if [ "${1:-}" = "--remove-addon" ]; then
  rm -f "$CLAUDE_DIR/$ADDON_NAME"
  if [ -f "$CLAUDE_DIR/CLAUDE.md" ]; then
    grep -vxF "@$ADDON_NAME" "$CLAUDE_DIR/CLAUDE.md" > "$CLAUDE_DIR/CLAUDE.md.tmp" && mv "$CLAUDE_DIR/CLAUDE.md.tmp" "$CLAUDE_DIR/CLAUDE.md"
  fi
  if [ ! -f "$PERMISSIONS_SRC" ]; then
    echo "ERROR: $PERMISSIONS_SRC is missing: the developer permissions cannot be removed from $CLAUDE_DIR/settings.json"
    exit 1
  fi
  developer_permissions remove
  echo "Developer add-on and its permissions removed from $CLAUDE_DIR"
  exit 0
fi
BRANCH="${THINKUBE_BRANCH:-main}"
METADATA_URL="https://raw.githubusercontent.com/thinkube/thinkube-metadata/${BRANCH}/repositories.json"
SSH_KEY="/home/thinkube/.ssh/github_ed25519"

if [ ! -f "$SSH_KEY" ]; then
  echo "ERROR: No GitHub SSH key at $SSH_KEY. It is created when code-server is deployed with a GitHub token."
  exit 1
fi
export GIT_SSH_COMMAND="ssh -i $SSH_KEY -o StrictHostKeyChecking=no"

if ! METADATA="$(curl -fsSL "$METADATA_URL")"; then
  echo "ERROR: Could not fetch $METADATA_URL"
  exit 1
fi

REPOS="$(echo "$METADATA" | jq -r '.repositories[] | select(.clone_for_development == true) | "\(.category) \(.name) \(.full_name)"')"
if [ -z "$REPOS" ]; then
  echo "ERROR: $METADATA_URL lists no repository with clone_for_development: true"
  exit 1
fi

while read -r category name full_name; do
  dest="$PLATFORM_DIR/$category/$name"
  if [ -d "$dest" ]; then
    echo "$category/$name: already present, left as it is"
    continue
  fi
  echo "$category/$name: cloning $full_name (branch $BRANCH)"
  mkdir -p "$PLATFORM_DIR/$category"
  git clone --quiet -b "$BRANCH" "git@github.com:$full_name.git" "$dest"
done <<< "$REPOS"

echo "Development repositories are in $PLATFORM_DIR"

# The add-on comes from the thinkube checkout just cloned (or already present).
if [ ! -f "$ADDON_SRC" ]; then
  echo "ERROR: $ADDON_SRC is missing: the thinkube checkout at $PLATFORM_DIR/core/thinkube has no developer add-on"
  exit 1
fi
mkdir -p "$CLAUDE_DIR"
cp "$ADDON_SRC" "$CLAUDE_DIR/$ADDON_NAME"
touch "$CLAUDE_DIR/CLAUDE.md"
if ! grep -qxF "@$ADDON_NAME" "$CLAUDE_DIR/CLAUDE.md"; then
  printf '@%s\n' "$ADDON_NAME" >> "$CLAUDE_DIR/CLAUDE.md"
fi
echo "Developer add-on installed: $CLAUDE_DIR/$ADDON_NAME, imported by $CLAUDE_DIR/CLAUDE.md"

if [ ! -f "$PERMISSIONS_SRC" ]; then
  echo "ERROR: $PERMISSIONS_SRC is missing: the thinkube checkout has no developer permissions"
  exit 1
fi
developer_permissions add
echo "Developer permissions merged into $CLAUDE_DIR/settings.json: every tool allowed, destructive git and GitHub actions ask"
