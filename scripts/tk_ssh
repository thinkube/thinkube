#!/bin/bash

# Copyright Alejandro Martínez Corriá and the Thinkube contributors
# SPDX-License-Identifier: Apache-2.0

# Run one shell command on a cluster node, from the code-server terminal.
# Usage: tk_ssh <host> <command>
#
# It uses Ansible's one-off command mode with the same inventory, address
# lookup and credentials as tk_ansible, so a node is reached the same way a
# playbook reaches it. A command that starts with sudo, or that reboots,
# shuts down, runs apt or systemctl, runs with become.

set -e

if [ $# -lt 2 ]; then
  echo "ERROR: Missing required arguments"
  echo "Usage: $0 <host> <command>"
  echo "Example: $0 tkamd2 'nvidia-smi'"
  exit 1
fi

HOST="$1"
shift
COMMAND="$*"

INVENTORY_DIR="/home/thinkube/.ansible/inventory"

if [ ! -f "$HOME/.env" ]; then
  echo "ERROR: $HOME/.env file not found"
  exit 1
fi
set -a
source "$HOME/.env"
set +a

if [ ! -f "$HOME/.venv/bin/activate" ]; then
  echo "ERROR: No Python virtual environment at $HOME/.venv"
  echo "It holds Ansible; the code-server deploy creates it."
  exit 1
fi
source "$HOME/.venv/bin/activate"

if [ -z "$ANSIBLE_BECOME_PASSWORD" ]; then
  echo "ERROR: ANSIBLE_BECOME_PASSWORD not set in .env"
  exit 1
fi
# The system user signs in over SSH and runs sudo with the same password.
export ANSIBLE_SSH_PASS="$ANSIBLE_BECOME_PASSWORD"
export ANSIBLE_HOST_KEY_CHECKING=False

if ! SYSTEM_USERNAME=$(python3 -c "import yaml; inv=yaml.safe_load(open('${INVENTORY_DIR}/inventory.yaml')); print(inv['all']['vars']['system_username'])"); then
  echo "ERROR: Cannot read all.vars.system_username from ${INVENTORY_DIR}/inventory.yaml"
  exit 1
fi
if [ -z "$SYSTEM_USERNAME" ]; then
  echo "ERROR: all.vars.system_username is empty in ${INVENTORY_DIR}/inventory.yaml"
  exit 1
fi

BECOME=()
if [[ "$COMMAND" == "sudo "* || "$COMMAND" == *"reboot"* || "$COMMAND" == *"shutdown"* || "$COMMAND" == *"apt"* || "$COMMAND" == *"systemctl"* ]]; then
  COMMAND="${COMMAND#sudo }"
  BECOME=(--become)
fi

TEMP_VARS="$(mktemp /tmp/tk-ssh-vars-XXXXXX.yml)"
trap 'rm -f "$TEMP_VARS"' EXIT
python3 - "$TEMP_VARS" "$SYSTEM_USERNAME" <<'EOF'
import json, os, sys
path, user = sys.argv[1:3]
with open(path, "w") as f:
    json.dump({"ansible_user": user,
               "ansible_ssh_pass": os.environ["ANSIBLE_SSH_PASS"],
               "ansible_become_pass": os.environ["ANSIBLE_BECOME_PASSWORD"]}, f)
EOF

ansible -i "${INVENTORY_DIR}/inventory.yaml" "$HOST" -m ansible.builtin.shell -a "$COMMAND" \
  "${BECOME[@]}" -e "@$TEMP_VARS"
